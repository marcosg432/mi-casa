# Supabase (obrigatório para salvar reservas)
# Use a Project URL da API — NÃO o link do dashboard.
# Exemplo correto: https://abcdefgh.supabase.co
# Dashboard → Project Settings → API → Project URL / service_role (ou secret key)
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_secreta

# Desativar login do painel temporariamente (1 = aberto, sem JWT)
DISABLE_PANEL_AUTH=1

# Autenticação do painel (obrigatório quando DISABLE_PANEL_AUTH não está ativo)
JWT_SECRET=substitua_por_string_aleatoria_com_pelo_menos_32_caracteres
ADMIN_USERNAME=seu_email@exemplo.com
ADMIN_PASSWORD_HASH=gerar_com_npm_run_hash-admin-password

# Sessão (8 horas)
SESSION_MAX_AGE_MS=28800000
SESSION_COOKIE_NAME=mcsc_session

# Cloudflare Turnstile (obrigatório em produção)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Servidor
PORT=3014
NODE_ENV=production

# Aviso de reserva no Gmail (senha de app do Google, não a senha normal)
NOTIFY_EMAIL=micasasucasaben@gmail.com
PUBLIC_SITE_URL=https://miicasasucasa.com.br
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Gmail do bot. ID e segredo do cliente OAuth no Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Reviews (opcional)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
